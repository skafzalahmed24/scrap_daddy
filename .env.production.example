APP_NAME="Scrap Daddy"
APP_ENV=production
# Generate with: php artisan key:generate --show   (keep the existing key if the site already has data)
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@YOUR-DOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

# Add your Razorpay / SMS keys here with the same names as your current .env
